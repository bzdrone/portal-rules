{
  "name": "portal-rules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "portal-rules": "dist/cli.js"
  },
  "scripts": {
    "pretest": "node scripts/ensure-sdk.mjs",
    "prebuild": "node scripts/ensure-sdk.mjs",
    "pretypecheck": "node scripts/ensure-sdk.mjs",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "emit": "tsx scripts/emit.ts",
    "gen:sdk": "node scripts/gen-sdk.mjs",
    "typecheck:out": "node scripts/typecheck.mjs",
    "compare": "tsx scripts/compare.ts",
    "survey": "node scripts/survey.mjs",
    "extract": "tsx scripts/extract.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "description": "Convert Battlefield 6 Portal block rules into TypeScript",
  "license": "MIT"
}
