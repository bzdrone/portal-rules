{
  "name": "portal-rules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:out": "node scripts/typecheck.mjs",
    "compare": "tsx scripts/compare.ts",
    "survey": "node scripts/survey.mjs",
    "extract": "tsx scripts/extract.ts",
    "convert": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "description": "Convert Battlefield 6 Portal block rules into TypeScript",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "portal-rules": "dist/cli.js"
  }
}
